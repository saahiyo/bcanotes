# Site URL (used for sitemap, canonical URLs, and Open Graph)
NEXT_PUBLIC_SITE_URL=https://bcanotes.tech/

# Google Drive API key for question papers / practicals
GOOGLE_DRIVE_API_KEY="[GCP_API_KEY]"

# Web3Forms access key for contact & contribute forms
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Google Apps Script URL for file uploads
GOOGLE_APPS_SCRIPT_URL=

# Admin Emails (comma-separated list)
NEXT_PUBLIC_ADMIN_EMAILS=
